{
  "manifest_version": 3,
  "name": "Markdown Convert",
  "version": "1.3.6",
  "description": "Convert any webpage to clean Markdown.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "markdown-convert@tanveerriaz.github",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Markdown Convert",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["readability.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
