{
  "manifest_version": 3,
  "name": "Markdown Convert",
  "version": "1.2.1",
  "description": "Convert any webpage to clean Markdown.",
  "action": {
    "default_title": "Markdown Convert",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["readability.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
